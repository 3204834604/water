.record-list {
  display: block;
}

.record-item {
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.record-list .record-item:last-child {
  margin-bottom: 0;
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.record-time {
  font-size: 24rpx;
  color: #8da2b4;
}

.record-score {
  font-size: 30rpx;
  font-weight: 950;
}

.record-tags {
  display: flex;
  margin-bottom: 14rpx;
}

.record-tags text + text {
  margin-left: 12rpx;
}

.record-tags text {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #eef5fc;
  color: #176fbf;
  font-size: 22rpx;
  font-weight: 800;
}

.record-label {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  color: #19304a;
}

.clear-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  border: 0;
  background: linear-gradient(135deg, #f56b65, #e84b54);
  color: #fff;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 88rpx;
}

.clear-btn::after {
  border: 0;
}

.empty-card {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #8da2b4;
  font-size: 30rpx;
}

.empty-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #a8bac9;
}
