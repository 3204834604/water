<view class="page-shell {{themeClass}}">
  <view class="page-title">
    <text class="name">个人中心</text>
    <text class="title-hint">记录、定位与反馈</text>
  </view>

  <view class="card user-card" bindtap="onUserCardTap">
    <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar">{{userName[0] || '水'}}</view>
    <view>
      <text class="user-name">{{userName}}</text>
      <text class="user-meta">累计检测 {{stats.count}} 次 · 标记点 {{stats.markers}} 个</text>
    </view>
  </view>

  <view class="menu-list">
    <block wx:for="{{menus}}" wx:key="action">
      <view class="card menu-item" data-index="{{index}}" bindtap="onMenuTap">
        <view class="menu-icon">{{item.icon}}</view>
        <view>
          <text class="menu-title">{{item.title}}</text>
          <text class="menu-desc">{{item.desc}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </block>
  </view>

  <view class="card map-card" bindtap="openMap">
    <text class="section-title">最近定位</text>
    <text class="map-text">点击打开地图查看已保存采样点</text>
    <view class="pin"></view>
  </view>
</view>
