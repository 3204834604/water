.home {
  padding-bottom: 44rpx;
}

.metric-card {
  padding: 26rpx;
}

.metric-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.metric-name {
  font-size: 30rpx;
  font-weight: 900;
}

.metric-control {
  display: flex;
  align-items: center;
}

.metric-control .step-btn {
  margin-right: 14rpx;
}

.metric-control .metric-input {
  margin-right: 14rpx;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #409cf0, #1f7bd2);
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 56rpx;
  box-shadow: 0 8rpx 14rpx rgba(47, 145, 232, 0.25);
}

.step-btn::after {
  border: 0;
}

.metric-input {
  width: 116rpx;
  height: 58rpx;
  border: 1rpx solid #d7e6f6;
  border-radius: 14rpx;
  background: #fff;
  color: #19304a;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
}

.boat-slider {
  height: 74rpx;
  position: relative;
}

.slider-track,
.slider-fill {
  position: absolute;
  left: 0;
  top: 34rpx;
  height: 12rpx;
  border-radius: 999rpx;
}

.slider-track {
  width: 100%;
  background: #e6edf4;
  box-shadow: inset 0 2rpx 5rpx rgba(25, 74, 130, 0.12);
}

.slider-fill {
  box-shadow: 0 4rpx 10rpx rgba(47, 145, 232, 0.18);
}

.slider-area {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 74rpx;
  background: transparent;
}

.boat-thumb {
  width: 70rpx;
  height: 70rpx;
  box-sizing: border-box;
  border: 5rpx solid #fff;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 18rpx rgba(25, 92, 170, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-image {
  width: 58rpx;
  height: 58rpx;
}

.range-labels {
  display: flex;
  justify-content: space-between;
  color: #9badbf;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.summary-strip {
  display: flex;
  padding: 20rpx 0;
  text-align: center;
}

.summary-strip > view {
  flex: 1;
}

.summary-strip text {
  display: block;
  color: #7e98b1;
  font-size: 22rpx;
  font-weight: 800;
}

.summary-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #19304a;
  font-weight: 900;
}

.quick-actions {
  display: flex;
  margin-bottom: 22rpx;
}

.quick-actions .action {
  flex: 1;
}

.quick-actions .action + .action {
  margin-left: 14rpx;
}

.action {
  min-height: 92rpx;
  padding: 0 6rpx;
  border: 0;
  border-radius: 16rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1.2;
  box-shadow: 0 10rpx 18rpx rgba(30, 90, 150, 0.12);
}

.action::after {
  border: 0;
}

.reset-action { background: linear-gradient(135deg, #ffb92d, #ff951a); }
.save-action { background: linear-gradient(135deg, #3d95e9, #276fc8); }
.history-action { background: linear-gradient(135deg, #25c99e, #12a87e); }
.map-action { background: linear-gradient(135deg, #f56b65, #e84b54); }
.report-action { background: linear-gradient(135deg, #8b65f4, #6e45df); }

.chart-card {
  padding: 26rpx;
}

.ghost-btn {
  height: 56rpx;
  padding: 0 22rpx;
  border: 1rpx solid #f3c6ca;
  border-radius: 14rpx;
  background: #fff;
  color: #e2515d;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 56rpx;
}

.ghost-btn::after {
  border: 0;
}

.chart-box {
  height: 300rpx;
  position: relative;
  overflow: hidden;
  background: #f8fbff;
  border-radius: 12rpx;
}

.chart-canvas {
  width: 100%;
  height: 300rpx;
  display: block;
}

.empty-history {
  padding: 60rpx 20rpx;
  text-align: center;
  color: #8da2b4;
  font-size: 26rpx;
}

.quality-card {
  padding: 30rpx 26rpx;
  border-left: 8rpx solid #28c49a;
}

.quality-top {
  display: flex;
  align-items: center;
}

.quality-top > view:first-child {
  flex: 1;
  margin-right: 20rpx;
}

.quality-label {
  display: flex;
  align-items: center;
  color: #19ae87;
  font-size: 40rpx;
  font-weight: 950;
}

.quality-label .drop-icon {
  margin-right: 16rpx;
}

.drop-icon {
  width: 44rpx;
  height: 58rpx;
  background: linear-gradient(180deg, #53c8ff, #2f91e8);
  border-radius: 50% 50% 50% 10%;
  transform: rotate(45deg);
}

.quality-note {
  display: block;
  margin-top: 28rpx;
  color: #6e8ba5;
  font-size: 26rpx;
  font-weight: 800;
}

.score-ring {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 156rpx;
  height: 156rpx;
}

.score-inner {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-inner text {
  color: #19ae87;
  line-height: 1;
}

.score-value {
  font-size: 42rpx;
  font-weight: 950;
}

.score-caption {
  margin-top: 4rpx;
  color: #6c8195;
  font-size: 18rpx;
}

.score-bars {
  margin-top: 28rpx;
}

.score-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 18rpx;
}

.score-row:last-child {
  margin-bottom: 0;
}

.score-row > text:first-child {
  flex: 0 0 92rpx;
  width: 92rpx;
}

.score-row > text:last-child {
  flex: 0 0 48rpx;
  width: 48rpx;
  text-align: right;
}

.score-row .score-track {
  flex: 1;
  margin: 0 14rpx;
}

.score-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: #edf3f8;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  border-radius: inherit;
}

.score-number {
  font-weight: 900;
}

.suggestion-card {
  padding: 26rpx;
}

.suggestion-count {
  color: #91a5b8;
  font-size: 24rpx;
  font-weight: 850;
}

.suggestion-item {
  border: 1rpx solid #ffd6da;
  background: #fff4f5;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-top: 16rpx;
}

.suggestion-title {
  display: flex;
  align-items: center;
  color: #394d61;
  font-size: 27rpx;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.suggestion-title .boat-icon {
  margin-right: 10rpx;
}

.suggestion-title text:not(.priority) {
  margin-right: 10rpx;
}

.boat-icon.small {
  width: 32rpx;
  height: 32rpx;
}

.priority {
  height: 34rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #ffe2e5;
  color: #e24e5a;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.suggestion-text {
  color: #668096;
  font-size: 24rpx;
  line-height: 1.65;
}
